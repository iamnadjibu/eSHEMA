rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
            : 'staff');
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'super_admin' || 
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@ksp.rw' ||
        request.auth.token.email == 'superadmin@ksp.rw' ||
        request.auth.token.email == 'nadjibullahu@gmail.com' ||
        request.auth.token.email == 'nadjibullah70@gmail.com'
      );
    }

    function isUserActive() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        )
      );
    }

    function isManager() {
      return isUserActive() && (getUserRole() == 'manager' || isSuperAdmin());
    }

    function isAccountant() {
      return isUserActive() && (getUserRole() == 'accountant' || isSuperAdmin());
    }

    function isOperator() {
      return isUserActive() && (getUserRole() == 'operator' || isManager() || isSuperAdmin());
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read: if isUserActive();
      allow create, update, delete: if isSuperAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // Attendance Records & Sessions
    match /attendance/{attendanceId} {
      allow read: if isUserActive();
      allow create, update: if isOperator();
      allow delete: if isSuperAdmin();
    }

    match /attendanceSessions/{sessionId} {
      allow read: if isUserActive();
      allow create, update: if isOperator();
      allow delete: if isSuperAdmin();
    }

    // Performance Ratings
    match /performanceRatings/{ratingId} {
      allow read: if isUserActive();
      allow write: if isManager();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // Organization Counters & Settings
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read: if isUserActive();
      allow write: if isManager();
    }
  }
}
